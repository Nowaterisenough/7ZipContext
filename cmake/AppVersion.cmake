set(7ZIPCONTEXT_VERSION "" CACHE STRING "Release version (MAJOR.MINOR.PATCH)")
set(7ZIPCONTEXT_UPDATE_REPOSITORY "Nowaterisenough/7ZipContext" CACHE STRING "GitHub update repository")
set(APP_VERSION "${7ZIPCONTEXT_VERSION}")
if(APP_VERSION STREQUAL "")
    set(APP_VERSION "1.0.0")
    find_package(Git QUIET)
    if(Git_FOUND)
        execute_process(COMMAND "${GIT_EXECUTABLE}" tag --merged HEAD WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" OUTPUT_VARIABLE _tags ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        string(REPLACE "\n" ";" _tags "${_tags}")
        set(_base "")
        foreach(_tag IN LISTS _tags)
            if(_tag MATCHES "^v([0-9]+\\.[0-9]+\\.[0-9]+)$")
                if(_base STREQUAL "" OR CMAKE_MATCH_1 VERSION_GREATER APP_VERSION)
                    set(_base "${_tag}")
                    set(APP_VERSION "${CMAKE_MATCH_1}")
                endif()
            endif()
        endforeach()
        if(NOT _base STREQUAL "")
            execute_process(COMMAND "${GIT_EXECUTABLE}" rev-list --count "${_base}..HEAD" WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" OUTPUT_VARIABLE _distance ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(_distance MATCHES "^[0-9]+$")
                string(REPLACE "." ";" _parts "${APP_VERSION}")
                list(GET _parts 0 _major)
                list(GET _parts 1 _minor)
                list(GET _parts 2 _patch)
                math(EXPR _patch "${_patch} + ${_distance}")
                set(APP_VERSION "${_major}.${_minor}.${_patch}")
            endif()
        endif()
    endif()
endif()
if(NOT APP_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Invalid release version: ${APP_VERSION}")
endif()
string(REPLACE "." ";" _version_parts "${APP_VERSION}")
list(GET _version_parts 0 APP_VERSION_MAJOR)
list(GET _version_parts 1 APP_VERSION_MINOR)
list(GET _version_parts 2 APP_VERSION_PATCH)
if(APP_VERSION_MAJOR GREATER 255 OR APP_VERSION_MINOR GREATER 255 OR APP_VERSION_PATCH GREATER 65535)
    message(FATAL_ERROR "Release version exceeds MSI limits")
endif()
if(NOT 7ZIPCONTEXT_UPDATE_REPOSITORY MATCHES "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
    message(FATAL_ERROR "Invalid update repository")
endif()
configure_file("${CMAKE_SOURCE_DIR}/src/AppBuild.h.in" "${CMAKE_BINARY_DIR}/generated/AppBuild.h" @ONLY)
configure_file("${CMAKE_SOURCE_DIR}/src/AppVersion.rc.in" "${CMAKE_BINARY_DIR}/generated/AppVersion.rc" @ONLY)
